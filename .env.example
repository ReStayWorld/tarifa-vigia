# URL pública del sitio (se usa en los links de los mails)
BASE_URL=http://localhost:3000

# Supabase (base de datos). Si faltan, en local se guarda todo en .data/db.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Precios: "serpapi" (Google Hotels real) o "demo" (precios simulados para probar)
PRICE_PROVIDER=demo
SERPAPI_KEY=

# Mails. Opción gratis: una cuenta de Gmail con "contraseña de aplicación".
# Si no hay nada configurado, los mails se muestran en la consola.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Alternativa: Resend (necesita dominio propio para mandar a cualquiera)
RESEND_API_KEY=
EMAIL_FROM=Tarifa Vigía <alertas@tudominio.com>

# Clave del panel del equipo (/admin)
ADMIN_PASSWORD=cambiame

# Clave que usa el cron de Vercel para llamar a /api/cron
CRON_SECRET=un-texto-largo-al-azar

# Reglas del servicio (las del Obligatorio 2)
ALERT_MIN_PCT=5
CHECK_EVERY_HOURS=48

# Tope de búsquedas de SerpApi por mes (el plan gratis trae 250)
SERPAPI_MONTHLY_LIMIT=240
